@prefix : <http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix MLOntology: <http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#> .
@base <http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology/> .

<http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology> rdf:type owl:Ontology .

################################################################# 
#    Object Properties
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#IsMathematicalUsedBy
MLOntology:IsMathematicalUsedBy rdf:type owl:ObjectProperty ;
                                owl:inverseOf MLOntology:usesMathematicalFoundation ;
                                rdf:type owl:AsymmetricProperty ,
                                         owl:IrreflexiveProperty .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#hasEvaluationMetric
MLOntology:hasEvaluationMetric rdf:type owl:ObjectProperty ;
                               owl:inverseOf MLOntology:isMetricOf ;
                               rdf:type owl:AsymmetricProperty ,
                                        owl:IrreflexiveProperty ;
                               rdfs:domain MLOntology:Algorithms ;
                               rdfs:range MLOntology:EvaluationMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isMetricOf
MLOntology:isMetricOf rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isSolvedBy
MLOntology:isSolvedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf MLOntology:isUsedInApplication ;
                      rdf:type owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain MLOntology:Applications ;
                      rdfs:range MLOntology:Algorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isUsedInApplication
MLOntology:isUsedInApplication rdf:type owl:ObjectProperty ,
                                        owl:AsymmetricProperty ,
                                        owl:IrreflexiveProperty .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation
MLOntology:usesMathematicalFoundation rdf:type owl:ObjectProperty ,
                                               owl:AsymmetricProperty ,
                                               owl:IrreflexiveProperty ;
                                      rdfs:domain MLOntology:Algorithms ;
                                      rdfs:range MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#utilizesMLType
MLOntology:utilizesMLType rdf:type owl:ObjectProperty ,
                                   owl:AsymmetricProperty ,
                                   owl:IrreflexiveProperty ;
                          rdfs:domain MLOntology:Algorithms ;
                          rdfs:range MLOntology:MLTypes .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Accuracy
MLOntology:Accuracy rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:ClassificationMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AdjustedRandIndex
MLOntology:AdjustedRandIndex rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ClusterMatchingMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Agglomerative
MLOntology:Agglomerative rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:HierarchicalClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms
MLOntology:Algorithms rdf:type owl:Class ;
                      owl:disjointWith MLOntology:EvaluationMetrics ,
                                       MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Applications
MLOntology:Applications rdf:type owl:Class .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ArtificialNeuralNetwork
MLOntology:ArtificialNeuralNetwork rdf:type owl:Class ;
                                   rdfs:subClassOf MLOntology:Algorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AutoEncoders
MLOntology:AutoEncoders rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BIC
MLOntology:BIC rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:ClusterValidityIndices .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BIRCH
MLOntology:BIRCH rdf:type owl:Class ;
                 rdfs:subClassOf MLOntology:HierarchicalClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BatchNormalization
MLOntology:BatchNormalization rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BayesianInference
MLOntology:BayesianInference rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ProbabilityAndStatistics ;
                             owl:disjointWith MLOntology:ProbabilityDistributions .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CACTUS
MLOntology:CACTUS rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:CategoricalClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CHAMELEON
MLOntology:CHAMELEON rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:HierarchicalClustering ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                       owl:someValuesFrom MLOntology:GraphTheory
                                     ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CLIQUE
MLOntology:CLIQUE rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:DensityClustering ,
                                  MLOntology:GridClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#COBWEB
MLOntology:COBWEB rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:ModelClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#COOLCAT
MLOntology:COOLCAT rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:CategoricalClustering ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:usesMathematicalFoundation ;
                                     owl:someValuesFrom MLOntology:Entropy
                                   ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CURE
MLOntology:CURE rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:HierarchicalClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calculus
MLOntology:Calculus rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calinski-Harabasz
MLOntology:Calinski-Harabasz rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ClusterValidityIndices .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CategoricalBoosting
MLOntology:CategoricalBoosting rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:TreeGradientBoosting .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CategoricalClustering
MLOntology:CategoricalClustering rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:ClusteringAlgorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChainRule
MLOntology:ChainRule rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:MultivariableCalculus ;
                     owl:disjointWith MLOntology:PartialDerivatives .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChurnPrediction
MLOntology:ChurnPrediction rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:Applications .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClassificationMetrics
MLOntology:ClassificationMetrics rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:GroundTruthDependentMetrics ;
                                 owl:disjointWith MLOntology:ClusterMatchingMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterMatchingMetrics
MLOntology:ClusterMatchingMetrics rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:GroundTruthDependentMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices
MLOntology:ClusterValidityIndices rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:GroundTruthIndependentMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusteringAlgorithms
MLOntology:ClusteringAlgorithms rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:Algorithms ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                                  owl:someValuesFrom MLOntology:ClusterValidityIndices
                                                ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CompleteLinkage
MLOntology:CompleteLinkage rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:HierarchicalClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ContractiveAE
MLOntology:ContractiveAE rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Contrastive
MLOntology:Contrastive rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ConvolutionalNN
MLOntology:ConvolutionalNN rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CosineSimilarity
MLOntology:CosineSimilarity rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:DistanceAndSimilarityMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CustomerSegmentation
MLOntology:CustomerSegmentation rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:Applications .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DBCLASD
MLOntology:DBCLASD rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:DensityClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DBSCAN
MLOntology:DBSCAN rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:DensityClustering ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty MLOntology:usesMathematicalFoundation ;
                                    owl:someValuesFrom MLOntology:EuclideanDistance
                                  ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCEC
MLOntology:DCEC rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCN
MLOntology:DCN rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DEC
MLOntology:DEC rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DENCLUE
MLOntology:DENCLUE rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:DensityClustering ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:usesMathematicalFoundation ;
                                     owl:someValuesFrom MLOntology:GradientDescent
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:usesMathematicalFoundation ;
                                     owl:someValuesFrom MLOntology:PartialDerivatives
                                   ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DataAugmentation
MLOntology:DataAugmentation rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DaviesBouldinIndex
MLOntology:DaviesBouldinIndex rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:ClusterValidityIndices .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DecisionTree
MLOntology:DecisionTree rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:TreeBased .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering
MLOntology:DeepLearningClustering rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:ClusteringAlgorithms ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                    owl:someValuesFrom MLOntology:ChainRule
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                    owl:someValuesFrom MLOntology:GradientDescent
                                                  ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepNeuralNetwork
MLOntology:DeepNeuralNetwork rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ArtificialNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DenoisingAE
MLOntology:DenoisingAE rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DensityClustering
MLOntology:DensityClustering rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ClusteringAlgorithms ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:usesMathematicalFoundation ;
                                               owl:someValuesFrom MLOntology:OptimizationTheories
                                             ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DistanceAndSimilarityMetrics
MLOntology:DistanceAndSimilarityMetrics rdf:type owl:Class ;
                                        rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Divisive
MLOntology:Divisive rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:HierarchicalClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Dropout
MLOntology:Dropout rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DunnsIndex
MLOntology:DunnsIndex rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:ClusterValidityIndices .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EarlyStopping
MLOntology:EarlyStopping rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EigenvaluesAndEigenvectors
MLOntology:EigenvaluesAndEigenvectors rdf:type owl:Class ;
                                      rdfs:subClassOf MLOntology:LinearAlgebra ;
                                      owl:disjointWith MLOntology:MatrixOperations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ElasticNet
MLOntology:ElasticNet rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Entropy
MLOntology:Entropy rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:InformationTheory .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EuclideanDistance
MLOntology:EuclideanDistance rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:DistanceAndSimilarityMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EvaluationMetrics
MLOntology:EvaluationMetrics rdf:type owl:Class ;
                             owl:disjointWith MLOntology:MLTypes ,
                                              MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ExpectationMaximization
MLOntology:ExpectationMaximization rdf:type owl:Class ;
                                   rdfs:subClassOf MLOntology:ModelClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ExtraTrees
MLOntology:ExtraTrees rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:TreeBagging ;
                      owl:disjointWith MLOntology:RandomForest .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ExtremeGB
MLOntology:ExtremeGB rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:TreeGradientBoosting .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#F1Score
MLOntology:F1Score rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:ClassificationMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FowlkesMallowsIndex
MLOntology:FowlkesMallowsIndex rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:ClusterMatchingMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FraudDetection
MLOntology:FraudDetection rdf:type owl:Class ;
                          rdfs:subClassOf MLOntology:Applications .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FuzzyKMeans
MLOntology:FuzzyKMeans rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:KMeans ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty MLOntology:usesMathematicalFoundation ;
                                         owl:someValuesFrom MLOntology:LagrangeMultipliers
                                       ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GaussianDistribution
MLOntology:GaussianDistribution rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:ProbabilityDistributions .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GaussianMixtureModels
MLOntology:GaussianMixtureModels rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:ModelClustering ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                   owl:someValuesFrom MLOntology:GaussianDistribution
                                                 ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GenerativeAdversarialNet
MLOntology:GenerativeAdversarialNet rdf:type owl:Class ;
                                    rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GradientDescent
MLOntology:GradientDescent rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:OptimizationTheories ;
                           owl:disjointWith MLOntology:LagrangeMultipliers .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GraphTheory
MLOntology:GraphTheory rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GridClustering
MLOntology:GridClustering rdf:type owl:Class ;
                          rdfs:subClassOf MLOntology:ClusteringAlgorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GridDBSCAN
MLOntology:GridDBSCAN rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:GridClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GroundTruthDependentMetrics
MLOntology:GroundTruthDependentMetrics rdf:type owl:Class ;
                                       rdfs:subClassOf MLOntology:EvaluationMetrics ;
                                       owl:disjointWith MLOntology:GroundTruthIndependentMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GroundTruthIndependentMetrics
MLOntology:GroundTruthIndependentMetrics rdf:type owl:Class ;
                                         rdfs:subClassOf MLOntology:EvaluationMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HDBSCAN
MLOntology:HDBSCAN rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:DensityClustering ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:usesMathematicalFoundation ;
                                     owl:someValuesFrom MLOntology:EuclideanDistance
                                   ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HardKMeans
MLOntology:HardKMeans rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:KMeans .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HiddenMarkovModels
MLOntology:HiddenMarkovModels rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:ModelClustering ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                owl:someValuesFrom MLOntology:ProbabilityDistributions
                                              ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HierarchicalClustering
MLOntology:HierarchicalClustering rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:ClusteringAlgorithms ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                    owl:someValuesFrom MLOntology:DistanceAndSimilarityMetrics
                                                  ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#IDEC
MLOntology:IDEC rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Inertia
MLOntology:Inertia rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:ClusterValidityIndices .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#InformationTheory
MLOntology:InformationTheory rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KCM_F
