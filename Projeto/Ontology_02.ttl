                                    owl:onProperty MLOntology:handlesNoiseOutliers ;
                                    owl:hasValue "true"^^xsd:boolean
                                  ] ;
                  rdfs:comment "Algoritmo hierarquico aglomerativo baseado em sumarios para dados categoricos (Nagpal et al., 2013)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#COOLCAT
MLOntology:COOLCAT rdf:type owl:Class ;
