@prefix : <http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix MLOntology: <http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#> .
@base <http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology/> .

<http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology> rdf:type owl:Ontology ;
    owl:versionInfo "Ciclo 2 - Propriedades de Dados e Modelos Baseados em Arvores (Ontology_02.ttl)" ;
    rdfs:comment "OntoML-Mod: Ontologia Orientada a Modelos e Algoritmos de Aprendizagem de Maquina Contemporaneos (CIn-UFPE)." .

#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#handlesNoiseOutliers
MLOntology:handlesNoiseOutliers rdf:type owl:DatatypeProperty ,
                                         owl:FunctionalProperty ;
                                rdfs:domain MLOntology:ClusteringAlgorithms ;
                                rdfs:range xsd:boolean ;
                                rdfs:comment "Indica se o algoritmo de agrupamento possui mecanismo explicito para identificar ou tolerar ruido e outliers (Nagpal et al., 2013; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#hasOptimalDirection
MLOntology:hasOptimalDirection rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain MLOntology:EvaluationMetrics ;
                               rdfs:range [ rdf:type rdfs:Datatype ;
                                            owl:oneOf ( "maximize"
                                                        "minimize"
                                                      )
                                          ] ;
                               rdfs:comment "Indica a direcao de otimizacao da metrica de avaliacao ('maximize' ou 'minimize')." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#requiresClusterCountK
MLOntology:requiresClusterCountK rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:domain MLOntology:ClusteringAlgorithms ;
                                 rdfs:range xsd:boolean ;
                                 rdfs:comment "Indica se o algoritmo exige a especificacao previa do numero de clusters k como parametro de entrada (Nagpal et al., 2013; Yin et al., 2026)." .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#IsMathematicalUsedBy
MLOntology:IsMathematicalUsedBy rdf:type owl:ObjectProperty ;
                                owl:inverseOf MLOntology:usesMathematicalFoundation ;
                                rdf:type owl:AsymmetricProperty ,
                                         owl:IrreflexiveProperty ;
                                rdfs:domain MLOntology:MathematicalFoundations ;
                                rdfs:range MLOntology:Algorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#hasEvaluationMetric
MLOntology:hasEvaluationMetric rdf:type owl:ObjectProperty ;
                               owl:inverseOf MLOntology:isMetricOf ;
                               rdf:type owl:AsymmetricProperty ,
                                        owl:IrreflexiveProperty ;
                               rdfs:domain MLOntology:Algorithms ;
                               rdfs:range MLOntology:EvaluationMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isMetricOf
MLOntology:isMetricOf rdf:type owl:ObjectProperty ,
                               owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain MLOntology:EvaluationMetrics ;
                      rdfs:range MLOntology:Algorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isSolvedBy
MLOntology:isSolvedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf MLOntology:isUsedInApplication ;
                      rdf:type owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain MLOntology:Applications ;
                      rdfs:range MLOntology:Algorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isUsedInApplication
MLOntology:isUsedInApplication rdf:type owl:ObjectProperty ,
                                        owl:AsymmetricProperty ,
                                        owl:IrreflexiveProperty ;
                               rdfs:domain MLOntology:Algorithms ;
                               rdfs:range MLOntology:Applications .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isMLTypeOf
MLOntology:isMLTypeOf rdf:type owl:ObjectProperty ;
                      owl:inverseOf MLOntology:utilizesMLType ;
                      rdf:type owl:AsymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain MLOntology:MLTypes ;
                      rdfs:range MLOntology:Algorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation
MLOntology:usesMathematicalFoundation rdf:type owl:ObjectProperty ,
                                               owl:AsymmetricProperty ,
                                               owl:IrreflexiveProperty ;
                                      rdfs:domain MLOntology:Algorithms ;
                                      rdfs:range MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#utilizesMLType
MLOntology:utilizesMLType rdf:type owl:ObjectProperty ,
                                   owl:AsymmetricProperty ,
                                   owl:IrreflexiveProperty ;
                          rdfs:domain MLOntology:Algorithms ;
                          rdfs:range MLOntology:MLTypes .


#################################################################
#    Classes - Top Level
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms
MLOntology:Algorithms rdf:type owl:Class ;
                      owl:disjointWith MLOntology:Applications ,
                                       MLOntology:EvaluationMetrics ,
                                       MLOntology:MLTypes ,
                                       MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Applications
MLOntology:Applications rdf:type owl:Class ;
                        owl:disjointWith MLOntology:EvaluationMetrics ,
                                         MLOntology:MLTypes ,
                                         MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EvaluationMetrics
MLOntology:EvaluationMetrics rdf:type owl:Class ;
                             owl:disjointWith MLOntology:MLTypes ,
                                              MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MLTypes
MLOntology:MLTypes rdf:type owl:Class ;
                   owl:disjointWith MLOntology:MathematicalFoundations ;
                   rdfs:comment "Paradigmas de aprendizado de maquina validados segundo Sarker (2021), Liu et al. (2023) e Zhuang et al. (2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MathematicalFoundations
MLOntology:MathematicalFoundations rdf:type owl:Class .


#################################################################
#    Classes - MLTypes
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ReinforcementLearning
MLOntology:ReinforcementLearning rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:MLTypes .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SelfSupervisedLearning
MLOntology:SelfSupervisedLearning rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:MLTypes ;
                                  rdfs:comment "Paradigma autogerado via tarefas pretexto (Generativo ou Contrastivo), conforme Liu et al. (2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SemiSupervisedLearning
MLOntology:SemiSupervisedLearning rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:MLTypes ;
                                  rdfs:comment "Inclui agrupamento semi-supervisionado com restricoes must-link e cannot-link (Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SupervisedLearning
MLOntology:SupervisedLearning rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:MLTypes .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#TransferLearning
MLOntology:TransferLearning rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:MLTypes ;
                            rdfs:comment "Paradigma de transferencia de conhecimento entre dominios (Zhuang et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#UnsupervisedLearning
MLOntology:UnsupervisedLearning rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:MLTypes .


#################################################################
#    Classes - EvaluationMetrics
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GroundTruthDependentMetrics
MLOntology:GroundTruthDependentMetrics rdf:type owl:Class ;
                                       rdfs:subClassOf MLOntology:EvaluationMetrics ;
                                       owl:disjointWith MLOntology:GroundTruthIndependentMetrics ;
                                       rdfs:comment "Metricas externas que requerem particao de referencia a priori (Yin et al., 2026; Simoes & de Carvalho, 2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GroundTruthIndependentMetrics
MLOntology:GroundTruthIndependentMetrics rdf:type owl:Class ;
                                         rdfs:subClassOf MLOntology:EvaluationMetrics ;
                                         rdfs:comment "Metricas internas que avaliam coesao e separacao sem rotulos externos (Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClassificationMetrics
MLOntology:ClassificationMetrics rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:GroundTruthDependentMetrics ;
                                 owl:disjointWith MLOntology:ClusterMatchingMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterMatchingMetrics
MLOntology:ClusterMatchingMetrics rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:GroundTruthDependentMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#RegressionMetrics
MLOntology:RegressionMetrics rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:GroundTruthDependentMetrics ;
                             rdfs:comment "Metricas supervisionadas para avaliacao de tarefas de regressao (Breiman et al., 1984; El Massari et al., 2022)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices
MLOntology:ClusterValidityIndices rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:GroundTruthIndependentMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Accuracy
MLOntology:Accuracy rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:ClassificationMetrics ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:hasOptimalDirection ;
                                      owl:hasValue "maximize"
                                    ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ErrorOfClassification
MLOntology:ErrorOfClassification rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:ClassificationMetrics ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty MLOntology:hasOptimalDirection ;
                                                   owl:hasValue "minimize"
                                                 ] ;
                                 rdfs:comment "Indice ER/OERC utilizado para avaliar particoes em de Carvalho et al. (2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#F1Score
MLOntology:F1Score rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:ClassificationMetrics ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:hasOptimalDirection ;
                                     owl:hasValue "maximize"
                                   ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#LogLoss
MLOntology:LogLoss rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:ClassificationMetrics ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:hasOptimalDirection ;
                                     owl:hasValue "minimize"
                                   ] ;
                   rdfs:comment "Perda logaritmica (entropia cruzada negativa) usada em classificadores probabilisticos baseados em gradient boosting (Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Precision
MLOntology:Precision rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:ClassificationMetrics ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:hasOptimalDirection ;
                                       owl:hasValue "maximize"
                                     ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ROC_AUC
MLOntology:ROC_AUC rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:ClassificationMetrics ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:hasOptimalDirection ;
                                     owl:hasValue "maximize"
                                   ] ;
                   rdfs:comment "Area sob a curva ROC usada para avaliacao de classificadores em dados tabulares e desbalanceados (Bentejac et al., 2021; El Massari et al., 2022)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Recall
MLOntology:Recall rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:ClassificationMetrics ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty MLOntology:hasOptimalDirection ;
                                    owl:hasValue "maximize"
                                  ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MAE
MLOntology:MAE rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:RegressionMetrics ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty MLOntology:hasOptimalDirection ;
                                 owl:hasValue "minimize"
                               ] ;
               rdfs:comment "Mean Absolute Error / Least Absolute Deviation (Breiman et al., 1984; Geurts et al., 2006; El Massari et al., 2022)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MSE
MLOntology:MSE rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:RegressionMetrics ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty MLOntology:hasOptimalDirection ;
                                 owl:hasValue "minimize"
                               ] ;
               rdfs:comment "Mean Squared Error (Breiman et al., 1984; Breiman, 2001; Geurts et al., 2006; El Massari et al., 2022)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#RMSE
MLOntology:RMSE rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:RegressionMetrics ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:hasOptimalDirection ;
                                  owl:hasValue "minimize"
                                ] ;
                rdfs:comment "Root Mean Squared Error (Bentejac et al., 2021; El Massari et al., 2022)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AdjustedRandIndex
MLOntology:AdjustedRandIndex rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ClusterMatchingMetrics ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:hasOptimalDirection ;
                                               owl:hasValue "maximize"
                                             ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FowlkesMallowsIndex
MLOntology:FowlkesMallowsIndex rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:ClusterMatchingMetrics ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty MLOntology:hasOptimalDirection ;
                                                 owl:hasValue "maximize"
                                               ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FuzzyRandIndexFrigui
MLOntology:FuzzyRandIndexFrigui rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:ClusterMatchingMetrics ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:hasOptimalDirection ;
                                                  owl:hasValue "maximize"
                                                ] ;
                                rdfs:comment "Variacao fuzzy do indice de Rand proposta por Frigui, utilizada em Simoes & de Carvalho (2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FuzzyRandIndexHullermeier
MLOntology:FuzzyRandIndexHullermeier rdf:type owl:Class ;
                                     rdfs:subClassOf MLOntology:ClusterMatchingMetrics ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty MLOntology:hasOptimalDirection ;
                                                       owl:hasValue "maximize"
                                                     ] ;
                                     rdfs:comment "Variacao fuzzy do indice de Rand proposta por Hullermeier, utilizada em Simoes & de Carvalho (2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#JaccardIndex
MLOntology:JaccardIndex rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:ClusterMatchingMetrics ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:hasOptimalDirection ;
                                          owl:hasValue "maximize"
                                        ] ;
                        rdfs:comment "Indice externo para particoes fuzzy utilizado em Simoes & de Carvalho (2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#NormalizedMutualInformation
MLOntology:NormalizedMutualInformation rdf:type owl:Class ;
                                       rdfs:subClassOf MLOntology:ClusterMatchingMetrics ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty MLOntology:hasOptimalDirection ;
                                                         owl:hasValue "maximize"
                                                       ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BIC
MLOntology:BIC rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:ClusterValidityIndices ;
               rdfs:comment "Criterio de Informacao Bayesiano; a direcao de otimizacao depende da convencao adotada (-2 log L + k log n para minimizar vs. log L - (k/2) log n para maximizar), permanecendo intencionalmente nao fixada em TBox." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calinski-Harabasz
MLOntology:Calinski-Harabasz rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ClusterValidityIndices ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:hasOptimalDirection ;
                                               owl:hasValue "maximize"
                                             ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DaviesBouldinIndex
MLOntology:DaviesBouldinIndex rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:ClusterValidityIndices ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty MLOntology:hasOptimalDirection ;
                                                owl:hasValue "minimize"
                                              ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DunnsIndex
MLOntology:DunnsIndex rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:ClusterValidityIndices ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:hasOptimalDirection ;
                                        owl:hasValue "maximize"
                                      ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GapStatistic
MLOntology:GapStatistic rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:ClusterValidityIndices ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:hasOptimalDirection ;
                                          owl:hasValue "maximize"
                                        ] ;
                        rdfs:comment "Estatistica Gap para estimativa do numero otimo de clusters K (Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Inertia
MLOntology:Inertia rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:ClusterValidityIndices ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:hasOptimalDirection ;
                                     owl:hasValue "minimize"
                                   ] ;
                   rdfs:comment "Soma dos quadrados intra-cluster (WCSS) usada no Elbow Method (Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ModifiedPartitionCoefficient
MLOntology:ModifiedPartitionCoefficient rdf:type owl:Class ;
                                        rdfs:subClassOf MLOntology:ClusterValidityIndices ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty MLOntology:hasOptimalDirection ;
                                                          owl:hasValue "maximize"
                                                        ] ;
                                        rdfs:comment "Indice de validade para particoes fuzzy utilizado em Simoes & de Carvalho (2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SilhouetteScore
MLOntology:SilhouetteScore rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:ClusterValidityIndices ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty MLOntology:hasOptimalDirection ;
                                             owl:hasValue "maximize"
                                           ] .


#################################################################
#    Classes - MathematicalFoundations
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calculus
MLOntology:Calculus rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MultivariableCalculus
MLOntology:MultivariableCalculus rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:Calculus .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChainRule
MLOntology:ChainRule rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:MultivariableCalculus ;
                     owl:disjointWith MLOntology:PartialDerivatives .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#PartialDerivatives
MLOntology:PartialDerivatives rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:MultivariableCalculus .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#TaylorExpansion
MLOntology:TaylorExpansion rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:Calculus ;
                           rdfs:comment "Expansao em serie de Taylor de 2a ordem (gradiente e Hessiana) aplicada a modelos modernos de gradient boosting (Bentejac et al., 2021; Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DistanceAndSimilarityMetrics
MLOntology:DistanceAndSimilarityMetrics rdf:type owl:Class ;
                                        rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CosineSimilarity
MLOntology:CosineSimilarity rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:DistanceAndSimilarityMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EuclideanDistance
MLOntology:EuclideanDistance rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:DistanceAndSimilarityMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#JaccardCoefficient
MLOntology:JaccardCoefficient rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:DistanceAndSimilarityMetrics ;
                              rdfs:comment "Coeficiente de similaridade citado para agrupamento hierarquico e categorico (Nagpal et al., 2013)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KernelFunctions
MLOntology:KernelFunctions rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:DistanceAndSimilarityMetrics ;
                           rdfs:comment "Funcoes de Kernel de Mercer para mapeamento nao-linear via distance kernel trick (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GaussianKernel
MLOntology:GaussianKernel rdf:type owl:Class ;
                          rdfs:subClassOf MLOntology:KernelFunctions ;
                          rdfs:comment "Kernel Gaussiano com hiperparametro de largura global ou local por cluster (de Carvalho et al., 2018; Simoes & de Carvalho, 2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ManhattanDistance
MLOntology:ManhattanDistance rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:DistanceAndSimilarityMetrics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GraphTheory
MLOntology:GraphTheory rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#InformationTheory
MLOntology:InformationTheory rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Entropy
MLOntology:Entropy rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:InformationTheory .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GainRatio
MLOntology:GainRatio rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:InformationTheory ;
                     rdfs:comment "Razao de ganho que normaliza o ganho de informacao pela informacao de divisao (split information) no algoritmo C4.5 (Quinlan, 1993)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#InformationGain
MLOntology:InformationGain rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:InformationTheory ;
                           rdfs:comment "Reducao esperada na entropia de Shannon usada como criterio de divisao no algoritmo ID3 (Quinlan, 1993)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#LinearAlgebra
MLOntology:LinearAlgebra rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EigenvaluesAndEigenvectors
MLOntology:EigenvaluesAndEigenvectors rdf:type owl:Class ;
                                      rdfs:subClassOf MLOntology:LinearAlgebra ;
                                      owl:disjointWith MLOntology:MatrixOperations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MatrixOperations
MLOntology:MatrixOperations rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:LinearAlgebra .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#OptimizationTheories
MLOntology:OptimizationTheories rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GradientDescent
MLOntology:GradientDescent rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:OptimizationTheories ;
                           owl:disjointWith MLOntology:LagrangeMultipliers .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#LagrangeMultipliers
MLOntology:LagrangeMultipliers rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:OptimizationTheories .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ProbabilityAndStatistics
MLOntology:ProbabilityAndStatistics rdf:type owl:Class ;
                                    rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BayesianInference
MLOntology:BayesianInference rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ProbabilityAndStatistics ;
                             owl:disjointWith MLOntology:ProbabilityDistributions .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BootstrapResampling
MLOntology:BootstrapResampling rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:ProbabilityAndStatistics ;
                               rdfs:comment "Reamostragem com reposicao (Bootstrap Aggregating) empregada em TreeBagging e Random Forests (Breiman, 2001)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ImpurityMeasures
MLOntology:ImpurityMeasures rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:ProbabilityAndStatistics ;
                            rdfs:comment "Criterios estatisticos de impureza e dispersao usados para selecao de divisoes em arvores de decisao (Breiman et al., 1984)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GiniImpurity
MLOntology:GiniImpurity rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:ImpurityMeasures ;
                        rdfs:comment "Indice de impureza de Gini (1 - sum p_i^2) para arvores de classificacao CART e Random Forest (Breiman et al., 1984; Breiman, 2001)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#VarianceReduction
MLOntology:VarianceReduction rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ImpurityMeasures ;
                             rdfs:comment "Criterio de reducao de variancia / erro quadratico em arvores de regressao (Breiman et al., 1984; Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ProbabilityDistributions
MLOntology:ProbabilityDistributions rdf:type owl:Class ;
                                    rdfs:subClassOf MLOntology:ProbabilityAndStatistics .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GaussianDistribution
MLOntology:GaussianDistribution rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:ProbabilityDistributions .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#RegularizationTechniques
MLOntology:RegularizationTechniques rdf:type owl:Class ;
                                    rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BatchNormalization
MLOntology:BatchNormalization rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DataAugmentation
MLOntology:DataAugmentation rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Dropout
MLOntology:Dropout rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EarlyStopping
MLOntology:EarlyStopping rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ElasticNet
MLOntology:ElasticNet rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EntropyRegularization
MLOntology:EntropyRegularization rdf:type owl:Class ;
                                 rdfs:subClassOf MLOntology:RegularizationTechniques ;
                                 rdfs:comment "Regularizacao por entropia positiva dos parametros de largura do kernel Gaussiano (Simoes & de Carvalho, 2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#TreePruning
MLOntology:TreePruning rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:RegularizationTechniques ;
                       rdfs:comment "Poda estrutural (custo-complexidade em CART, erro pessimista em C4.5 e penalizacao por numero de folhas gamma*T em XGBoost; Breiman et al., 1984; Quinlan, 1993; Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#WeightDecay
MLOntology:WeightDecay rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:RegularizationTechniques .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#L1_Reg
MLOntology:L1_Reg rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:WeightDecay ;
                  rdfs:comment "Also known as Lasso Regression." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#L2_Reg
MLOntology:L2_Reg rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:WeightDecay ;
                  rdfs:comment "Also known as Ridge Regression." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SignalProcessing
MLOntology:SignalProcessing rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:MathematicalFoundations .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#WaveletTransform
MLOntology:WaveletTransform rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:SignalProcessing .


#################################################################
#    Classes - Applications
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AnomalyDetection
MLOntology:AnomalyDetection rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:Applications ;
                            rdfs:comment "Deteccao de anomalias e outliers em redes e transacoes (Yin et al., 2026; Nagpal et al., 2013)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Bioinformatics
MLOntology:Bioinformatics rdf:type owl:Class ;
                          rdfs:subClassOf MLOntology:Applications ;
                          rdfs:comment "Analise de expressao genica e sequencias (de Carvalho et al., 2018; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChurnPrediction
MLOntology:ChurnPrediction rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:Applications .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CustomerSegmentation
MLOntology:CustomerSegmentation rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:Applications .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Cybersecurity
MLOntology:Cybersecurity rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:Applications ;
                         rdfs:comment "Deteccao de intrusoes, malware e analise de ameacas em seguranca cibernetica (Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DataMining
MLOntology:DataMining rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:Applications ;
                      rdfs:comment "Mineracao de dados em larga escala e benchmarks tabulares (Nagpal et al., 2013; Yin et al., 2026; Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FraudDetection
MLOntology:FraudDetection rdf:type owl:Class ;
                          rdfs:subClassOf MLOntology:Applications ;
                          rdfs:comment "Deteccao de fraudes financeiras e cartoes de credito (Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HealthcareDiagnosis
MLOntology:HealthcareDiagnosis rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:Applications ;
                               rdfs:comment "Diagnostico medico e analise clinica preditiva em saude (El Massari et al., 2022; Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ImageSegmentation
MLOntology:ImageSegmentation rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:Applications ;
                             rdfs:comment "Segmentacao e analise de imagens (Simoes & de Carvalho, 2023; de Carvalho et al., 2018; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#InformationRetrieval
MLOntology:InformationRetrieval rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:Applications ;
                                rdfs:comment "Recuperacao de informacao e agrupamento de documentos (de Carvalho et al., 2018; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#NetworkAnalysis
MLOntology:NetworkAnalysis rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:Applications ;
                           rdfs:comment "Deteccao de comunidades e analise de redes sociais (Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#PatternRecognition
MLOntology:PatternRecognition rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:Applications ;
                              rdfs:comment "Reconhecimento de padroes (Nagpal et al., 2013; de Carvalho et al., 2018; Simoes & de Carvalho, 2023; Yin et al., 2026)." .


#################################################################
#    Classes - ClusteringAlgorithms & Subclasses
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusteringAlgorithms
MLOntology:ClusteringAlgorithms rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:Algorithms ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                                  owl:someValuesFrom MLOntology:ClusterValidityIndices
                                                ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#PartitionClustering
MLOntology:PartitionClustering rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:ClusteringAlgorithms ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                 owl:someValuesFrom MLOntology:OptimizationTheories
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty MLOntology:utilizesMLType ;
                                                 owl:someValuesFrom MLOntology:UnsupervisedLearning
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty MLOntology:requiresClusterCountK ;
                                                 owl:hasValue "true"^^xsd:boolean
                                               ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KMeans
MLOntology:KMeans rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:PartitionClustering ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty MLOntology:handlesNoiseOutliers ;
                                    owl:hasValue "false"^^xsd:boolean
                                  ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HardKMeans
MLOntology:HardKMeans rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:KMeans ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:usesMathematicalFoundation ;
                                        owl:someValuesFrom MLOntology:EuclideanDistance
                                      ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SphericalKMeans
MLOntology:SphericalKMeans rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:KMeans ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty MLOntology:usesMathematicalFoundation ;
                                             owl:someValuesFrom MLOntology:CosineSimilarity
                                           ] ;
                           rdfs:comment "Variante do K-Means em hiperesfera unitaria usando similaridade do cosseno (Dhillon & Modha, 2001; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#FuzzyKMeans
MLOntology:FuzzyKMeans rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:KMeans ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty MLOntology:usesMathematicalFoundation ;
                                         owl:someValuesFrom MLOntology:EuclideanDistance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty MLOntology:usesMathematicalFoundation ;
                                         owl:someValuesFrom MLOntology:LagrangeMultipliers
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty MLOntology:usesMathematicalFoundation ;
                                         owl:someValuesFrom MLOntology:PartialDerivatives
                                       ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KernelKMeans
MLOntology:KernelKMeans rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:KMeans ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:usesMathematicalFoundation ;
                                          owl:someValuesFrom MLOntology:KernelFunctions
                                        ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KernelHardKMeans
MLOntology:KernelHardKMeans rdf:type owl:Class ;
                            rdfs:subClassOf MLOntology:KernelKMeans ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty MLOntology:usesMathematicalFoundation ;
                                              owl:someValuesFrom MLOntology:GaussianKernel
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty MLOntology:usesMathematicalFoundation ;
                                              owl:someValuesFrom MLOntology:PartialDerivatives
                                            ] ;
                            rdfs:comment "Algoritmos Gaussian Kernel c-means hard clustering (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KCM_K
MLOntology:KCM_K rdf:type owl:Class ;
                 rdfs:subClassOf MLOntology:KernelHardKMeans ;
                 owl:disjointWith MLOntology:KCM_F ;
                 rdfs:comment "Gaussian kernel c-means with kernelization of the metric (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KCM_K_GH
MLOntology:KCM_K_GH rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:KCM_K ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:usesMathematicalFoundation ;
                                      owl:someValuesFrom MLOntology:LagrangeMultipliers
                                    ] ;
                    owl:disjointWith MLOntology:KCM_K_LH ;
                    rdfs:comment "KCM-K com computacao automatica de vetor global de hiperparametros de largura via Multiplicadores de Lagrange (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KCM_K_LH
MLOntology:KCM_K_LH rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:KCM_K ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:usesMathematicalFoundation ;
                                      owl:someValuesFrom MLOntology:LagrangeMultipliers
                                    ] ;
                    rdfs:comment "KCM-K com computacao automatica de vetores locais de hiperparametros de largura por cluster via Multiplicadores de Lagrange (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KCM_F
MLOntology:KCM_F rdf:type owl:Class ;
                 rdfs:subClassOf MLOntology:KernelHardKMeans ;
                 rdfs:comment "Gaussian kernel c-means in the feature space (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KCM_F_GH
MLOntology:KCM_F_GH rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:KCM_F ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:usesMathematicalFoundation ;
                                      owl:someValuesFrom MLOntology:LagrangeMultipliers
                                    ] ;
                    owl:disjointWith MLOntology:KCM_F_LH ;
                    rdfs:comment "KCM-F com computacao automatica de vetor global de hiperparametros de largura via Multiplicadores de Lagrange (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KCM_F_LH
MLOntology:KCM_F_LH rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:KCM_F ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:usesMathematicalFoundation ;
                                      owl:someValuesFrom MLOntology:LagrangeMultipliers
                                    ] ;
                    rdfs:comment "KCM-F com computacao automatica de vetores locais de hiperparametros de largura por cluster via Multiplicadores de Lagrange (de Carvalho et al., 2018)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KernelFuzzyKMeans
MLOntology:KernelFuzzyKMeans rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:KernelKMeans ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:hasEvaluationMetric ;
                                               owl:someValuesFrom MLOntology:FuzzyRandIndexFrigui
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:hasEvaluationMetric ;
                                               owl:someValuesFrom MLOntology:FuzzyRandIndexHullermeier
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:hasEvaluationMetric ;
                                               owl:someValuesFrom MLOntology:ModifiedPartitionCoefficient
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:usesMathematicalFoundation ;
                                               owl:someValuesFrom MLOntology:GaussianKernel
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:usesMathematicalFoundation ;
                                               owl:someValuesFrom MLOntology:LagrangeMultipliers
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:usesMathematicalFoundation ;
                                               owl:someValuesFrom MLOntology:PartialDerivatives
                                             ] ;
                             owl:disjointWith MLOntology:KernelHardKMeans ;
                             rdfs:comment "Gaussian kernel fuzzy c-means (Simoes & de Carvalho, 2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KFCM_K
MLOntology:KFCM_K rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:KernelFuzzyKMeans .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KFCM_W
MLOntology:KFCM_W rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:KFCM_K ;
                  owl:disjointWith MLOntology:KFCM_Ew ;
                  rdfs:comment "KFCM-K-W: computacao automatica de parametros de largura sob restricao de produto (Simoes & de Carvalho, 2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KFCM_W1
MLOntology:KFCM_W1 rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:KFCM_W ;
                   owl:disjointWith MLOntology:KFCM_W2 .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KFCM_W2
MLOntology:KFCM_W2 rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:KFCM_W .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KFCM_Ew
MLOntology:KFCM_Ew rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:KFCM_K ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:usesMathematicalFoundation ;
                                     owl:someValuesFrom MLOntology:Entropy
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty MLOntology:usesMathematicalFoundation ;
                                     owl:someValuesFrom MLOntology:EntropyRegularization
                                   ] ;
                   rdfs:comment "KFCM-K-Ew: computacao automatica de parametros de largura via regularizacao por entropia positiva sob restricao de soma (Simoes & de Carvalho, 2023)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KFCM_Ew1
MLOntology:KFCM_Ew1 rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:KFCM_Ew ;
                    owl:disjointWith MLOntology:KFCM_Ew2 .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KFCM_Ew2
MLOntology:KFCM_Ew2 rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:KFCM_Ew .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#KMedoids
MLOntology:KMedoids rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:PartitionClustering ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:usesMathematicalFoundation ;
                                      owl:someValuesFrom MLOntology:DistanceAndSimilarityMetrics
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:handlesNoiseOutliers ;
                                      owl:hasValue "true"^^xsd:boolean
                                    ] ;
                    rdfs:comment "Agrupamento baseado em medoides representativos (Nagpal et al., 2013; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#PAM
MLOntology:PAM rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:KMedoids ;
