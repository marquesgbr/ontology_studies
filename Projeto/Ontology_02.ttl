MLOntology:KModes rdf:type owl:Class ;
                  rdfs:subClassOf MLOntology:CategoricalClustering ,
                                  MLOntology:PartitionClustering ;
                  rdfs:comment "Algoritmo de particao para dados categoricos usando modas e frequencias (Nagpal et al., 2013)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#LIMBO
MLOntology:LIMBO rdf:type owl:Class ;
                 rdfs:subClassOf MLOntology:CategoricalClustering ,
                                 MLOntology:HierarchicalClustering ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty MLOntology:usesMathematicalFoundation ;
                                   owl:someValuesFrom MLOntology:InformationTheory
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty MLOntology:handlesNoiseOutliers ;
                                   owl:hasValue "false"^^xsd:boolean
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty MLOntology:requiresClusterCountK ;
                                   owl:hasValue "true"^^xsd:boolean
                                 ] ;
                 rdfs:comment "Algoritmo hierarquico escalavel para dados categoricos baseado em matriz de probabilidade e teoria da informacao (Nagpal et al., 2013)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#STIRR
MLOntology:STIRR rdf:type owl:Class ;
                 rdfs:subClassOf MLOntology:CategoricalClustering ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty MLOntology:usesMathematicalFoundation ;
                                   owl:someValuesFrom MLOntology:EigenvaluesAndEigenvectors
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty MLOntology:usesMathematicalFoundation ;
                                   owl:someValuesFrom MLOntology:GraphTheory
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty MLOntology:handlesNoiseOutliers ;
                                   owl:hasValue "true"^^xsd:boolean
                                 ] ;
                 rdfs:comment "Sieving Through Iterated Relational Reinforcement: propaga pesos ate ponto fixo em grafo multipartido de valores categoricos, generalizando metodos espectrais nao-lineares e autovetores principais (Gibson et al., 1998; Nagpal et al., 2013)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ModelClustering
MLOntology:ModelClustering rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:ClusteringAlgorithms ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty MLOntology:usesMathematicalFoundation ;
                                             owl:someValuesFrom MLOntology:ProbabilityAndStatistics
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty MLOntology:utilizesMLType ;
                                             owl:someValuesFrom MLOntology:UnsupervisedLearning
                                           ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AutoClass
MLOntology:AutoClass rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:ModelClustering ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                       owl:someValuesFrom MLOntology:BayesianInference
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:requiresClusterCountK ;
                                       owl:hasValue "false"^^xsd:boolean
                                     ] ;
                     rdfs:comment "Usa analise estatistica Bayesiana para estimar o numero de clusters (Nagpal et al., 2013; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CLASSIT
MLOntology:CLASSIT rdf:type owl:Class ;
                   rdfs:subClassOf MLOntology:ModelClustering ,
