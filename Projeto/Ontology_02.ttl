                                                       owl:someValuesFrom MLOntology:BayesianInference
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty MLOntology:requiresClusterCountK ;
                                                       owl:hasValue "true"^^xsd:boolean
                                                     ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering
MLOntology:DeepLearningClustering rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:ClusteringAlgorithms ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                    owl:someValuesFrom MLOntology:ChainRule
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                    owl:someValuesFrom MLOntology:GradientDescent
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty MLOntology:utilizesMLType ;
                                                    owl:someValuesFrom MLOntology:UnsupervisedLearning
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty MLOntology:requiresClusterCountK ;
                                                    owl:hasValue "true"^^xsd:boolean
                                                  ] ;
                                  rdfs:comment "Deep representation-based clustering (Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Contrastive
MLOntology:Contrastive rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:DeepLearningClustering ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty MLOntology:utilizesMLType ;
                                         owl:someValuesFrom MLOntology:SelfSupervisedLearning
                                       ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCEC
MLOntology:DCEC rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCN
MLOntology:DCN rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DEC
MLOntology:DEC rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#IDEC
MLOntology:IDEC rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:DeepLearningClustering .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#VaDE
MLOntology:VaDE rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:DeepLearningClustering ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:ProbabilityDistributions
                                ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SemiSupervisedClustering
MLOntology:SemiSupervisedClustering rdf:type owl:Class ;
                                    rdfs:subClassOf MLOntology:ClusteringAlgorithms ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty MLOntology:utilizesMLType ;
                                                      owl:someValuesFrom MLOntology:SemiSupervisedLearning
                                                    ] ;
                                    rdfs:comment "Agrupamento semi-supervisionado guiado por restricoes pareadas (must-link e cannot-link) ou rotulos parciais (Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ConstrainedKMeans
MLOntology:ConstrainedKMeans rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:SemiSupervisedClustering ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:usesMathematicalFoundation ;
                                               owl:someValuesFrom MLOntology:EuclideanDistance
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:usesMathematicalFoundation ;
                                               owl:someValuesFrom MLOntology:OptimizationTheories
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:handlesNoiseOutliers ;
                                               owl:hasValue "false"^^xsd:boolean
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty MLOntology:requiresClusterCountK ;
                                               owl:hasValue "true"^^xsd:boolean
                                             ] ;
                             owl:disjointWith MLOntology:SemiSupervisedFuzzyCMeans ;
                             rdfs:comment "COP-KMeans: extensao semi-supervisionada de K-Means com restricoes must-link e cannot-link (Wagstaff et al., 2001; Yin et al., 2026)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SemiSupervisedFuzzyCMeans
MLOntology:SemiSupervisedFuzzyCMeans rdf:type owl:Class ;
                                     rdfs:subClassOf MLOntology:SemiSupervisedClustering ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                       owl:someValuesFrom MLOntology:EuclideanDistance
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                       owl:someValuesFrom MLOntology:LagrangeMultipliers
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                       owl:someValuesFrom MLOntology:PartialDerivatives
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty MLOntology:handlesNoiseOutliers ;
                                                       owl:hasValue "false"^^xsd:boolean
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty MLOntology:requiresClusterCountK ;
                                                       owl:hasValue "true"^^xsd:boolean
                                                     ] ;
                                     rdfs:comment "SSFCM: Fuzzy C-Means semi-supervisionado orientado por rotulos parciais ou restricoes pareadas (Benkhalifa et al., 1999; Yin et al., 2026)." .


#################################################################
#    Classes - Other Algorithms (ANN & TreeBased)
#################################################################

###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ArtificialNeuralNetwork
MLOntology:ArtificialNeuralNetwork rdf:type owl:Class ;
                                   rdfs:subClassOf MLOntology:Algorithms .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepNeuralNetwork
MLOntology:DeepNeuralNetwork rdf:type owl:Class ;
                             rdfs:subClassOf MLOntology:ArtificialNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AutoEncoders
MLOntology:AutoEncoders rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ContractiveAE
MLOntology:ContractiveAE rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DenoisingAE
MLOntology:DenoisingAE rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#OverCompleteAE
MLOntology:OverCompleteAE rdf:type owl:Class ;
                          rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#SparseAE
MLOntology:SparseAE rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#StackedAE
MLOntology:StackedAE rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#UnderCompleteAE
MLOntology:UnderCompleteAE rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#VariationalAE
MLOntology:VariationalAE rdf:type owl:Class ;
                         rdfs:subClassOf MLOntology:AutoEncoders .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ConvolutionalNN
MLOntology:ConvolutionalNN rdf:type owl:Class ;
                           rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GenerativeAdversarialNet
MLOntology:GenerativeAdversarialNet rdf:type owl:Class ;
                                    rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Kolmogorov-ArnoldNet
MLOntology:Kolmogorov-ArnoldNet rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#LongShort-TermMemoryNet
MLOntology:LongShort-TermMemoryNet rdf:type owl:Class ;
                                   rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MultiLayerPerceptron
MLOntology:MultiLayerPerceptron rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:ArtificialNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#RadialBasisFunctionNet
MLOntology:RadialBasisFunctionNet rdf:type owl:Class ;
                                  rdfs:subClassOf MLOntology:ArtificialNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Self-OrganizingMap
MLOntology:Self-OrganizingMap rdf:type owl:Class ;
                              rdfs:subClassOf MLOntology:ArtificialNeuralNetwork ,
                                              MLOntology:ModelClustering ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                owl:someValuesFrom MLOntology:EuclideanDistance
                                              ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Transformers
MLOntology:Transformers rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:DeepNeuralNetwork .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#TreeBased
MLOntology:TreeBased rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:Algorithms ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:hasEvaluationMetric ;
                                       owl:someValuesFrom MLOntology:ClassificationMetrics
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:utilizesMLType ;
                                       owl:someValuesFrom MLOntology:SupervisedLearning
                                     ] ;
                     rdfs:comment "Familia de algoritmos supervisionados baseados em arvores de decisao e ensembles paralelos/sequenciais (Sarker, 2021; Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DecisionTree
MLOntology:DecisionTree rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:TreeBased ;
                        rdfs:comment "Arvores de decisao individuais com particionamento recursivo alinhado aos eixos (Quinlan, 1993; Breiman et al., 1984)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ID3
MLOntology:ID3 rdf:type owl:Class ;
               rdfs:subClassOf MLOntology:DecisionTree ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty MLOntology:hasEvaluationMetric ;
                                 owl:someValuesFrom MLOntology:Accuracy
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty MLOntology:hasEvaluationMetric ;
                                 owl:someValuesFrom MLOntology:ErrorOfClassification
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty MLOntology:usesMathematicalFoundation ;
                                 owl:someValuesFrom MLOntology:Entropy
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty MLOntology:usesMathematicalFoundation ;
                                 owl:someValuesFrom MLOntology:InformationGain
                               ] ;
               rdfs:comment "Iterative Dichotomiser 3: inducao top-down de arvores de classificacao baseada em entropia de Shannon e ganho de informacao (descrito em Quinlan, 1993; Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#C4_5
MLOntology:C4_5 rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:DecisionTree ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                  owl:someValuesFrom MLOntology:Accuracy
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                  owl:someValuesFrom MLOntology:ErrorOfClassification
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:Entropy
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:GainRatio
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:TreePruning
                                ] ;
                rdfs:comment "Sucessor do ID3 com razao de ganho normalizada, suporte a atributos continuos e poda por erro pessimista (Quinlan, 1993)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CART
MLOntology:CART rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:DecisionTree ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                  owl:someValuesFrom MLOntology:Accuracy
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                  owl:someValuesFrom MLOntology:RegressionMetrics
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:GiniImpurity
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:TreePruning
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:VarianceReduction
                                ] ;
                rdfs:comment "Classification and Regression Trees: particoes binarias por impureza de Gini ou reducao de variancia com poda custo-complexidade (Breiman et al., 1984)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ParallelTreeEnsemble
MLOntology:ParallelTreeEnsemble rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:TreeBased ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                                  owl:someValuesFrom MLOntology:RegressionMetrics
                                                ] ;
                                rdfs:comment "Comites paralelos de arvores que reduzem variancia via agregacao (bagging ou randomizacao extrema; Breiman, 2001; Geurts et al., 2006)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#TreeBagging
MLOntology:TreeBagging rdf:type owl:Class ;
                       rdfs:subClassOf MLOntology:ParallelTreeEnsemble ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty MLOntology:usesMathematicalFoundation ;
                                         owl:someValuesFrom MLOntology:BootstrapResampling
                                       ] ;
                       rdfs:comment "Ensembles paralelos baseados em Bootstrap Aggregating (Breiman, 2001; Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#RandomForest
MLOntology:RandomForest rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:TreeBagging ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:hasEvaluationMetric ;
                                          owl:someValuesFrom MLOntology:Accuracy
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:hasEvaluationMetric ;
                                          owl:someValuesFrom MLOntology:RMSE
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:hasEvaluationMetric ;
                                          owl:someValuesFrom MLOntology:ROC_AUC
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:usesMathematicalFoundation ;
                                          owl:someValuesFrom MLOntology:GiniImpurity
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:usesMathematicalFoundation ;
                                          owl:someValuesFrom MLOntology:VarianceReduction
                                        ] ;
                        rdfs:comment "Combina bagging via bootstrap com subamostragem aleatoria de atributos em cada divisao de arvore (Breiman, 2001)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ExtraTrees
MLOntology:ExtraTrees rdf:type owl:Class ;
                      rdfs:subClassOf MLOntology:ParallelTreeEnsemble ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:hasEvaluationMetric ;
                                        owl:someValuesFrom MLOntology:Accuracy
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:hasEvaluationMetric ;
                                        owl:someValuesFrom MLOntology:ErrorOfClassification
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:hasEvaluationMetric ;
                                        owl:someValuesFrom MLOntology:MSE
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:usesMathematicalFoundation ;
                                        owl:someValuesFrom MLOntology:GiniImpurity
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:usesMathematicalFoundation ;
                                        owl:someValuesFrom MLOntology:ProbabilityDistributions
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty MLOntology:usesMathematicalFoundation ;
                                        owl:someValuesFrom MLOntology:VarianceReduction
                                      ] ;
                      owl:disjointWith MLOntology:TreeBagging ;
                      rdfs:comment "Extremely Randomized Trees: seleciona pontos de corte aleatorios e utiliza por padrao a amostra integral sem bootstrap (Geurts et al., 2006)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#TreeBoosting
MLOntology:TreeBoosting rdf:type owl:Class ;
                        rdfs:subClassOf MLOntology:TreeBased ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:hasEvaluationMetric ;
                                          owl:someValuesFrom MLOntology:RegressionMetrics
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty MLOntology:usesMathematicalFoundation ;
                                          owl:someValuesFrom MLOntology:OptimizationTheories
                                        ] ;
                        rdfs:comment "Comites sequenciais aditivos de arvores baseados em reponderacao adaptativa ou boosting por gradiente (Freund & Schapire, 1997; Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AdaBoost
MLOntology:AdaBoost rdf:type owl:Class ;
                    rdfs:subClassOf MLOntology:TreeBoosting ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:hasEvaluationMetric ;
                                      owl:someValuesFrom MLOntology:Accuracy
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:hasEvaluationMetric ;
                                      owl:someValuesFrom MLOntology:ErrorOfClassification
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty MLOntology:usesMathematicalFoundation ;
                                      owl:someValuesFrom MLOntology:ProbabilityAndStatistics
                                    ] ;
                    rdfs:comment "Adaptive Boosting com reponderacao exponencial sequencial de instancias mal classificadas (Freund & Schapire, 1997; Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#TreeGradientBoosting
MLOntology:TreeGradientBoosting rdf:type owl:Class ;
                                rdfs:subClassOf MLOntology:TreeBoosting ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                                  owl:someValuesFrom MLOntology:LogLoss
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                                  owl:someValuesFrom MLOntology:RMSE
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:hasEvaluationMetric ;
                                                  owl:someValuesFrom MLOntology:ROC_AUC
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                  owl:someValuesFrom MLOntology:GradientDescent
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                  owl:someValuesFrom MLOntology:PartialDerivatives
                                                ] ;
                                rdfs:comment "Gradient Boosted Decision Trees (GBDT): otimizacao funcional aditiva via descida de gradiente em espaco de funcoes e derivadas parciais (Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CategoricalBoosting
MLOntology:CategoricalBoosting rdf:type owl:Class ;
                               rdfs:subClassOf MLOntology:TreeGradientBoosting ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                 owl:someValuesFrom MLOntology:L2_Reg
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                 owl:someValuesFrom MLOntology:TaylorExpansion
                                               ] ;
                               rdfs:comment "CatBoost: Ordered Boosting contra vies de predicao, arvores simetricas (oblivious trees), aproximacao de 2a ordem e regularizacao L2 (Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ExtremeGB
MLOntology:ExtremeGB rdf:type owl:Class ;
                     rdfs:subClassOf MLOntology:TreeGradientBoosting ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                       owl:someValuesFrom MLOntology:L1_Reg
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                       owl:someValuesFrom MLOntology:L2_Reg
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                       owl:someValuesFrom MLOntology:TaylorExpansion
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty MLOntology:usesMathematicalFoundation ;
                                       owl:someValuesFrom MLOntology:TreePruning
                                     ] ;
                     rdfs:comment "XGBoost: expansao de Taylor de 2a ordem (gradiente e Hessiana), regularizacao L1/L2 nas folhas e penalidade estrutural gamma*T (Bentejac et al., 2021; Sarker, 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GradientBoostingMachine
MLOntology:GradientBoostingMachine rdf:type owl:Class ;
                                   rdfs:subClassOf MLOntology:TreeGradientBoosting ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty MLOntology:usesMathematicalFoundation ;
                                                     owl:someValuesFrom MLOntology:VarianceReduction
                                                   ] ;
                                   rdfs:comment "GBM classico: ajuste sequencial de arvores de regressao aos pseudo-residuos por gradiente funcional de 1a ordem e reducao de variancia (Bentejac et al., 2021)." .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#LightGBMachine
MLOntology:LightGBMachine rdf:type owl:Class ;
                          rdfs:subClassOf MLOntology:TreeGradientBoosting ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty MLOntology:usesMathematicalFoundation ;
                                            owl:someValuesFrom MLOntology:L1_Reg
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty MLOntology:usesMathematicalFoundation ;
                                            owl:someValuesFrom MLOntology:L2_Reg
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty MLOntology:usesMathematicalFoundation ;
                                            owl:someValuesFrom MLOntology:TaylorExpansion
                                          ] ;
                          rdfs:comment "LightGBM: histogramas de discretizacao, amostragem GOSS, crescimento leaf-wise, expansao de Taylor de 2a ordem e regularizacao L1/L2 (Bentejac et al., 2021)." .


