                                     owl:onProperty MLOntology:requiresClusterCountK ;
                                     owl:hasValue "false"^^xsd:boolean
                                   ] ;
                   rdfs:comment "Extensao do COBWEB para agrupamento incremental de dados continuos (Nagpal et al., 2013)." .


