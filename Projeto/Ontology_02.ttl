###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Accuracy
MLOntology:Accuracy rdf:type owl:NamedIndividual ,
                             MLOntology:Accuracy ;
                    MLOntology:hasOptimalDirection "maximize" .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AdaBoost
MLOntology:AdaBoost rdf:type owl:NamedIndividual ,
                             MLOntology:AdaBoost ;
                    MLOntology:usesMathematicalFoundation MLOntology:OptimizationTheories ,
