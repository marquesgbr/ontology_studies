                                                      MLOntology:RandomForest .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#inst_reconhecimento_padroes
MLOntology:inst_reconhecimento_padroes rdf:type owl:NamedIndividual ,
                                                MLOntology:PatternRecognition ;
                                       MLOntology:isSolvedBy MLOntology:AdaBoost ,
                                                             MLOntology:Agglomerative ,
                                                             MLOntology:HardKMeans ,
                                                             MLOntology:KCM_F_LH ,
                                                             MLOntology:KCM_K_LH ,
                                                             MLOntology:KFCM_Ew2 ,
                                                             MLOntology:RandomForest .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#inst_recuperacao_informacao
MLOntology:inst_recuperacao_informacao rdf:type owl:NamedIndividual ,
                                                MLOntology:InformationRetrieval ;
                                       MLOntology:isSolvedBy MLOntology:DBSCAN ,
                                                             MLOntology:HardKMeans ,
                                                             MLOntology:SphericalKMeans .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#inst_segmentacao_imagens
MLOntology:inst_segmentacao_imagens rdf:type owl:NamedIndividual ,
                                             MLOntology:ImageSegmentation ;
                                    MLOntology:isSolvedBy MLOntology:FuzzyKMeans ,
                                                          MLOntology:KCM_K_GH ,
                                                          MLOntology:KFCM_Ew1 ,
                                                          MLOntology:MeanShift .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#inst_segmentacao_varejo
MLOntology:inst_segmentacao_varejo rdf:type owl:NamedIndividual ,
                                            MLOntology:CustomerSegmentation ;
                                   MLOntology:isSolvedBy MLOntology:HardKMeans ,
                                                         MLOntology:KFCM_Ew1 .


#################################################################
#    Annotations
#################################################################

MLOntology:Self-OrganizingMap rdfs:comment "Also known as Kohonen Networks, Self-Organizing Maps (SOMs) are biologically inspired neural networks that perform unsupervised learning and dimensionality reduction (Nagpal et al., 2013; de Carvalho et al., 2018)." ;
                              rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Self-organizing_map" .


