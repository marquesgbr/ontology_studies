                                    ] .


###  http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ROCK
MLOntology:ROCK rdf:type owl:Class ;
                rdfs:subClassOf MLOntology:CategoricalClustering ,
                                MLOntology:HierarchicalClustering ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:usesMathematicalFoundation ;
                                  owl:someValuesFrom MLOntology:JaccardCoefficient
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:handlesNoiseOutliers ;
                                  owl:hasValue "true"^^xsd:boolean
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty MLOntology:requiresClusterCountK ;
                                  owl:hasValue "true"^^xsd:boolean
                                ] ;
                rdfs:comment "RObust Clustering using linKs: algoritmo hierarquico aglomerativo para dados categoricos baseado em vizinhos comuns e coeficiente de Jaccard, nao em funcao de distancia metrica (Nagpal et al., 2013, p. 172)." .


