<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology/"
     xml:base="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:MLOntology="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#IsMathematicalUsedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#IsMathematicalUsedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#hasEvaluationMetric -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#hasEvaluationMetric">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isMetricOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EvaluationMetrics"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isMetricOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isMetricOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isSolvedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isSolvedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isUsedInApplication"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Applications"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isUsedInApplication -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#isUsedInApplication">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MathematicalFoundations"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#utilizesMLType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#utilizesMLType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MLTypes"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Accuracy -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Accuracy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClassificationMetrics"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AdjustedRandIndex -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#AdjustedRandIndex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterMatchingMetrics"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Agglomerative -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Agglomerative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HierarchicalClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EvaluationMetrics"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MathematicalFoundations"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Applications -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Applications"/>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BIC -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BIC">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BIRCH -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BIRCH">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HierarchicalClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BayesianInference -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#BayesianInference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ProbabilityAndStatistics"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ProbabilityDistributions"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CACTUS -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CACTUS">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CategoricalClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CHAMELEON -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CHAMELEON">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HierarchicalClustering"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GraphTheory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CLIQUE -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CLIQUE">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DensityClustering"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GridClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#COBWEB -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#COBWEB">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ModelClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#COOLCAT -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#COOLCAT">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CategoricalClustering"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Entropy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CURE -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CURE">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HierarchicalClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calculus -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calculus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MathematicalFoundations"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calinski-Harabasz -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Calinski-Harabasz">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CategoricalClustering -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CategoricalClustering">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusteringAlgorithms"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChainRule -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChainRule">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#MultivariableCalculus"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#PartialDerivatives"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChurnPrediction -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ChurnPrediction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Applications"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClassificationMetrics -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClassificationMetrics">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GroundTruthDependentMetrics"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterMatchingMetrics"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterMatchingMetrics -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterMatchingMetrics">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GroundTruthDependentMetrics"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GroundTruthIndependentMetrics"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusteringAlgorithms -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusteringAlgorithms">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Algorithms"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#hasEvaluationMetric"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CompleteLinkage -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CompleteLinkage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#HierarchicalClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Contrastive -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Contrastive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CosineSimilarity -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CosineSimilarity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DistanceAndSimilarityMetrics"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CustomerSegmentation -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#CustomerSegmentation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#Applications"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DBCLASD -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DBCLASD">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DensityClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DBSCAN -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DBSCAN">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DensityClustering"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#EuclideanDistance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCEC -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCEC">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCN -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DCN">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DEC -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DEC">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DENCLUE -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DENCLUE">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DensityClustering"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#GradientDescent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#usesMathematicalFoundation"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#PartialDerivatives"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DaviesBouldinIndex -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DaviesBouldinIndex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusterValidityIndices"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#DeepLearningClustering">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/MLOntology#ClusteringAlgorithms"/>
