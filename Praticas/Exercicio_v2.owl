        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment></rdfs:comment>
        <rdfs:label>DestinoSemTransporteMilhas</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio#Cliente"/>
                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio/c"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio#fazViagem"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio/c"/>
                                <swrl:argument2 rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio/v"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio#temDestino"/>
                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio/v"/>
                                        <swrl:argument2 rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio/dest"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio#Cidade"/>
                                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio/dest"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                <rdf:first>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                                                        <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio#temAeroportoPerto"/>
                                                        <swrl:argument1 rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/7/Exercicio/dest"/>
                                                        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
                                                    </rdf:Description>
                                                </rdf:first>
                                                <rdf:rest>
