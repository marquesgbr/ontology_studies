                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabriel/ontologies/2026/8/trip_agency#localizadoEm"/>
                                                <owl:hasValue rdf:resource="http://www.semanticweb.org/gabriel/ontologies/2026/8/trip_agency#Europa"/>
