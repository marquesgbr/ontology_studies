    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#temCobertura -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#temCobertura">
