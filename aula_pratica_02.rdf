    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#temBase -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#temBase">
