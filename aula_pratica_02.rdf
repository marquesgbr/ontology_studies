        <rdfs:domain rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Vehicle"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#lê -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#lê">
