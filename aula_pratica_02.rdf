                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#CoisaBranca"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Van"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#lê"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Tabloide"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


