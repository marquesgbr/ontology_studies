    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#AmigoDosAnimais -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#AmigoDosAnimais">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#temPet"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minCardinality>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Animal -->

