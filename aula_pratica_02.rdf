    </owl:Class>
    


    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#BusDriver -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#BusDriver">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#drives"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Bus"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#Person"/>
    </owl:Class>
    


