    <!-- http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#PizzaMarg -->

    <owl:Class rdf:about="http://www.semanticweb.org/gabrielstamford/ontologies/2026/8/Aula02#PizzaMarg">
